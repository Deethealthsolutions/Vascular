# Supabase project for the Research documents register.
# Copy to .env.local and fill in from Supabase → Project settings → API.
# Without these, the Research documents screen runs in local demo mode (browser storage only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: force the Research documents screen into local demo mode even when keys are set
# (training sessions, automated tests). Leave unset for normal use.
# NEXT_PUBLIC_RESEARCH_STORAGE=local

# Log-in: signs the session cookie. Server-only (no NEXT_PUBLIC_), 32+ random characters, keep secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everybody out.
AUTH_SECRET=
